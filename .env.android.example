# Android web bundle
ANDROID_API_ORIGIN=https://ontrack.hsichen.dev

# Play Console monetization public licensing key (Base64 RSA, not a secret).
# Required to enable verified supporter purchases.
PLAY_BILLING_PUBLIC_KEY=

# Release identity. Increment ANDROID_VERSION_CODE for every Play upload.
ANDROID_VERSION_NAME=0.2.0
ANDROID_VERSION_CODE=1

# Upload keystore. Use absolute paths in shared or CI environments.
ANDROID_KEYSTORE_PATH=/absolute/path/to/ontrack-upload.jks
ANDROID_KEYSTORE_PASSWORD=replace-me
ANDROID_KEY_ALIAS=ontrack-upload
ANDROID_KEY_PASSWORD=replace-me

# Google Play publishing. Keep the service account JSON outside the repository.
PLAY_SERVICE_ACCOUNT_JSON=/absolute/path/to/play-service-account.json
PLAY_TRACK=internal
PLAY_RELEASE_STATUS=draft
